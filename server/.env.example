PORT=5050
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/online_food_ordering
# Vercel MongoDB Atlas integration usually provides MONGODB_URI automatically.
JWT_SECRET=replace_with_a_strong_secret
# Optional for same-service production deploys. Use a comma-separated list for split frontend/backend deploys.
CLIENT_URL=http://localhost:4321,http://127.0.0.1:4321
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
